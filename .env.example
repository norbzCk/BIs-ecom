# Postgres connection strings used by Prisma. DIRECT_URL is used for
# migrations/introspection; DATABASE_URL is used by the running app (can be
# the same value, or a pooled connection string in production).
DATABASE_URL="postgresql://user:password@localhost:5432/billionare?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/billionare?schema=public"

# Secret used to sign/verify JWTs issued by the auth module. Generate one with
# e.g. `openssl rand -base64 48`. Required — the app will not start without it.
JWT_SECRET="change-me-to-a-long-random-value"

# How long an access token stays valid. Any value accepted by the `ms`
# package (e.g. "7d", "12h", "30m").
JWT_EXPIRES_IN="7d"

# Comma-separated list of origins allowed to call this API via CORS.
# Defaults to http://localhost:5173 (the apps/web dev server) if unset.
CORS_ORIGINS="http://localhost:5173"

# bcrypt cost factor for password hashing. Leave unset in production (12).
# Tests lower it to 4 because bcryptjs is pure JS and 12 rounds costs ~7s.
# Must be an integer from 4 to 15.
# SALT_ROUNDS="12"

# ---------------------------------------------------------------------------
# Supabase Storage (admin product image uploads)
# ---------------------------------------------------------------------------
# The admin editor uploads product photos to Supabase Storage. The upload is
# proxied by the API (src/storage/) rather than sent from the browser, so the
# service-role key never has to reach the frontend. It is a SERVER secret: do
# not prefix it with NEXT_PUBLIC_ and do not commit it.
#
# Without SUPABASE_SERVICE_ROLE_KEY the app still starts, but
# POST /api/admin/uploads/images answers 503 and image upload is unavailable.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Optional. The project URL the storage client talks to. Falls back to
# NEXT_PUBLIC_SUPABASE_URL when unset, which is already present in most
# projects, so this only needs setting if the two ever differ.
# SUPABASE_URL="https://your-project-ref.supabase.co"

