# Postgres connection strings used by Prisma. DIRECT_URL is used for
# migrations/introspection; DATABASE_URL is used by the running app (can be
# the same value, or a pooled connection string in production).
DATABASE_URL="postgresql://user:password@localhost:5432/billionare?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/billionare?schema=public"

# Secret used to sign/verify JWTs issued by the auth module. Generate one with
# e.g. `openssl rand -base64 48`. Required — the app will not start without it.
JWT_SECRET="change-me-to-a-long-random-value"

# How long an access token stays valid. Any value accepted by the `ms`
# package (e.g. "7d", "12h", "30m").
JWT_EXPIRES_IN="7d"

# Comma-separated list of origins allowed to call this API via CORS.
# Defaults to http://localhost:5173 (the apps/web dev server) if unset.
CORS_ORIGINS="http://localhost:5173"
